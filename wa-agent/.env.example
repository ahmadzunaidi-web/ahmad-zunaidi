# All optional for local demo. Without them: WhatsApp sends are logged, a keyword demo model replies.
PORT=3000
ADMIN_TOKEN=change-me
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

WA_VERIFY_TOKEN=change-me-verify
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Local only:
# ALLOW_UNSIGNED=1
# ECHO_FALLBACK=1
# DEV_SIMULATOR=1

# Circuit breaker: max AI runs per conversation per hour
# AI_MAX_RUNS_PER_HOUR=40

# Inbound media (defaults shown)
# MEDIA_DIR=data/media
# MEDIA_MAX_MB=16
# MEDIA_RETENTION_DAYS=30

# Opt-in voice-note transcription (audio is sent to this provider)
# TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
